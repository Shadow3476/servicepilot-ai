# Copy these into your shell environment (Streamlit does not load .env itself).
# No credentials belong here: AWS credentials come from `aws configure`,
# `aws login`, an SSO profile, or an IAM role.

# Region/table the ADMIN panel reads. Must match where your Lambda writes tickets.
SERVICEPILOT_AWS_REGION=us-west-1
SERVICEPILOT_TABLE_NAME=ServicePilotTickets

# Optional: named AWS CLI profile to use (leave unset for the default chain).
# SERVICEPILOT_AWS_PROFILE=my-profile

# Public ticket-creation endpoint used by the customer form.
SERVICEPILOT_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/tickets

# Optional Amazon Bedrock triage (off by default; each use is billed per token).
# SERVICEPILOT_AI_ENABLED=true
# SERVICEPILOT_AI_MODEL_ID=<a model id you have enabled in Bedrock>
# SERVICEPILOT_AI_REGION=us-west-2
